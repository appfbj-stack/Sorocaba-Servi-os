# ===== Kairós Serviços API =====
NODE_ENV=development
PORT=3051
LOG_LEVEL=info

# ===== Database =====
# Local: postgres://USER:PASS@localhost:5432/kairos_servicos
# Docker: postgres://kairos_servicos:PASS@kairos-servicos-pg:5432/kairos_servicos
DATABASE_URL=postgres://kairos_servicos:CHANGE_ME@localhost:5432/kairos_servicos

# ===== Auth =====
# 64+ chars em prod. Gerar: openssl rand -hex 48
JWT_SECRET=change-me-in-prod-please-use-openssl-rand-hex-48
JWT_EXPIRES_IN=30d

# ===== CORS =====
# Em dev: http://localhost:5173
# Em prod: https://servicos.fbautomacao.space
CORS_ORIGIN=http://localhost:5173

# ===== Monetização (defaults — alteráveis via painel admin) =====
# Quando monetization_enabled=true, essas chaves viram defaults,
# mas o admin sobrescreve via tabela settings.
MONETIZATION_ENABLED=false
LOJISTA_PRICE_MONTHLY=19.99
LOJISTA_FREE_MONTHS=6
PROFISSIONAL_FREE_CREDITS=10
PROFISSIONAL_FREE_CREDITS_VALIDITY_DAYS=180
CREDIT_PACK_QTY=10
CREDIT_PACK_PRICE=49.90
CREDIT_PACK_VALIDITY_DAYS=90

# ===== PIX =====
PIX_KEY=02598018796
PIX_KEY_TYPE=cpf
PIX_MERCHANT_NAME=Kairos Servicos
PIX_MERCHANT_CITY=Sorocaba

# ===== Storage (MinIO / S3-compatible) =====
# Endpoint interno do MinIO no Docker: http://minio:9000
# Local dev: http://localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kairos-servicos-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
# URL pública (o que vai pro banco de dados e aparece pro cliente)
# Em prod: https://servicos.fbautomacao.space/uploads (Caddy faz proxy pro MinIO)
# Em dev: http://localhost:9000/kairos-servicos-images
S3_PUBLIC_URL=https://servicos.fbautomacao.space/uploads

# ===== Admin seed =====
# Cria admin@kairos.com / admin123 no primeiro boot (troque a senha!)
ADMIN_EMAIL=admin@kairos.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador
