# ===== Kairós Serviços — Web (frontend) =====
# Build Vite, serve via `vite preview` em prod

FROM node:22-alpine AS build
WORKDIR /app
# Instala git pro pegar a versão no commit (não usado aqui, mas útil pra Vite)
RUN apk add --no-cache git
COPY package.json package.json
# NÃO copiamos bun.lock — ele é do Bun, não do npm.
# Usamos --no-package-lock pra ignorar lockfiles conflitantes.
RUN npm install --no-audit --no-fund --legacy-peer-deps
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache git
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
RUN npm install --omit=dev --no-audit --no-fund --legacy-peer-deps
EXPOSE 3000
USER node
CMD ["npx", "vite", "preview", "--port", "3000", "--host", "0.0.0.0", "--allowed-hosts", "all"]
